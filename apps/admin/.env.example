# Copiar a .env.local y completar con los valores del proyecto Supabase de GateFlow.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública real del sitio de apps/guard en Netlify — no de este sitio
# (admin). El QR de retiro siempre apunta a la app de guardia, sin
# importar desde cuál de las dos apps se registró el paquete. Ver la
# misma variable documentada en apps/guard/.env.example.
NEXT_PUBLIC_GUARD_APP_URL=https://tu-sitio-guard.netlify.app

# /registro (alta pública con trial): secreto del servidor para los
# hashes HMAC de correo/IP del rate limit y el token de tiempo del
# formulario. SIN prefijo NEXT_PUBLIC_. Mínimo 16 caracteres; en
# Netlify como variable secreta. Sin ella, /registro se deshabilita.
REGISTRO_HASH_PEPPER=
# Cloudflare Turnstile (anti-bot). Opcional hoy; obligatorio antes de
# producción. Sin TURNSTILE_SECRET_KEY el desafío se omite.
# TURNSTILE_SECRET_KEY=

# Billing (Stripe, México) — docs/operations/BILLING.md. Solo en el
# servidor: NUNCA con prefijo NEXT_PUBLIC_. En Netlify como variables
# secretas. Sin STRIPE_SECRET_KEY o STRIPE_WEBHOOK_SECRET los pagos en
# línea quedan deshabilitados (la pantalla lo indica).
# STRIPE_SECRET_KEY=            clave secreta (sk_test_… en staging)
# STRIPE_WEBHOOK_SECRET=        whsec_… del endpoint /api/billing/webhook/stripe
# STRIPE_PORTAL_CONFIGURATION_ID=   bpc_… del portal (cancelar al final del periodo, sin cambio de plan)
# STRIPE_PERMITIR_LIVE=         "true" solo en producción, para aceptar una clave live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PERMITIR_LIVE=
# URL pública de este sitio (Admin), para success/cancel del checkout y
# el retorno del portal. Ya usada por los correos de invitación.
NEXT_PUBLIC_ADMIN_APP_URL=https://tu-sitio-admin.netlify.app
